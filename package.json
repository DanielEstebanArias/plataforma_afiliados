{
  "name": "superapp-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "affiliates": "node scripts/start-affiliates.cjs",
    "affiliates:legacy": "node affiliates/server.cjs",
    "affiliates:core:test": "tsx --test tests/integration/affiliates-core.test.ts",
    "affiliates:demo": "node affiliates/demo.cjs",
    "affiliates:test": "node --test affiliates/tests/*.test.cjs",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "dev": "npm run build && npm start",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "bootstrap": "node --env-file=.env --import tsx scripts/bootstrap.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"portal/*.{js,css,html}\"",
    "affiliates:scale:test": "tsx --test tests/integration/affiliates-scale.test.ts",
    "affiliates:production": "node dist/src/affiliates/production.js",
    "affiliates:db:prepare": "node deploy/railway/prepare-db.cjs",
    "affiliates:bootstrap": "node dist/scripts/bootstrap-affiliates-production.js",
    "affiliates:frontend:build": "node deploy/vercel/build.cjs",
    "affiliates:deploy:test": "npm run build && node --test tests/integration/deploy-config.test.cjs tests/integration/production-deploy.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@prisma/client": "6.19.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "firebase-admin": "^13.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "mqtt": "^5.10.0",
    "openai": "^6.0.0",
    "puppeteer": "^24.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "prettier": "3.6.2",
    "prisma": "6.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
